@* Full-screen info overlay for one program item: video, description and equipment for each step. *@
@inject LibraryService Library
@inject SettingsService Settings

<div class="item-info" role="dialog" aria-modal="true" aria-label="@Item.Name">
    <div class="item-info-body">
        <div class="row between mb">
            <button class="btn-sm" @onclick="Close">‹ Back</button>
            @if (Item.Category is { } category)
            {
                <CategoryChip Category="category" />
            }
        </div>

        <h1>@Item.Name</h1>

        @if (Item.Kind == LibraryItemKind.Combo)
        {
            @if (!string.IsNullOrWhiteSpace(ComboDescription))
            {
                <p class="muted">@ComboDescription</p>
            }

            <div class="row wrap mb" style="gap:.4rem">
                <span class="chip accent">@EnumDisplay.Duration(Item.TotalSeconds) total</span>
                <span class="chip">Combo of @Item.Steps.Count</span>
                @if (Item.Alternating)
                {
                    <span class="chip accent">All exercises left, then right</span>
                }
                @EquipmentChips(Library.ItemEquipment(Item))
            </div>

            @for (int i = 0; i < Item.Steps.Count; i++)
            {
                var step = Item.Steps[i];
                var number = i + 1;
                <div class="card">
                    <div class="row between mb" style="gap:.6rem">
                        <div class="row" style="gap:.6rem">
                            <span class="index-badge">@number</span>
                            <strong>@step.Name</strong>
                        </div>
                        <span class="muted small">@EnumDisplay.Duration(step.DurationSeconds)</span>
                    </div>
                    <ExerciseMedia VideoUrl="@VideoUrl(step)" Title="@step.Name" />
                    @if (!string.IsNullOrWhiteSpace(Description(step)))
                    {
                        <p class="muted small mt" style="margin-bottom:0">@Description(step)</p>
                    }
                </div>
            }
        }
        else if (Item.Steps.Count > 0)
        {
            var step = Item.Steps[0];

            <ExerciseMedia VideoUrl="@VideoUrl(step)" Title="@step.Name" />

            @if (!string.IsNullOrWhiteSpace(Description(step)))
            {
                <p class="muted mt">@Description(step)</p>
            }

            <div class="row wrap mt" style="gap:.4rem">
                <span class="chip accent">@EnumDisplay.Duration(step.DurationSeconds)@(Item.Alternating ? " per side" : "")</span>
                @if (Item.Alternating)
                {
                    <span class="chip accent">Both sides</span>
                }
                @EquipmentChips(Library.ItemEquipment(Item))
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProgramItem Item { get; set; } = new();

    [Parameter] public EventCallback OnClose { get; set; }

    private string? ComboDescription => Library.GetCombo(Item.SourceId)?.Description;

    private string? VideoUrl(ProgramStep step)
        => !string.IsNullOrWhiteSpace(step.VideoUrl) ? step.VideoUrl : Library.GetExercise(step.ExerciseId)?.VideoUrl;

    private string? Description(ProgramStep step)
        => !string.IsNullOrWhiteSpace(step.Description) ? step.Description : Library.GetExercise(step.ExerciseId)?.Description;

    private RenderFragment EquipmentChips(List<Equipment> equipment) => __builder =>
    {
        if (equipment.Count == 0)
        {
            <span class="chip ok">No equipment</span>
            return;
        }

        foreach (var item in equipment)
        {
            <span class="chip @(Settings.Settings.OwnedEquipment.Contains(item) ? "ok" : "warn")">@item.Label()</span>
        }
    };

    private Task Close() => OnClose.InvokeAsync();
}
