@page "/generate"
@inject NavigationManager Nav
@inject SettingsService Settings
@inject LibraryService Library
@inject ProgramGenerator Generator
@inject DraftProgramState Draft

<PageTitle>Generate · Chrysos</PageTitle>

<h1>Generate a session</h1>

<div class="card">
    <div class="field">
        <label>Session length: <strong>@Options.TotalMinutes min</strong></label>
        <input type="range" min="5" max="90" step="5" value="@Options.TotalMinutes"
               @oninput="SetMinutes" />
    </div>

    <div class="field">
        <label>Difficulty</label>
        <select @bind="Options.Difficulty">
            @foreach (var level in Enum.GetValues<DifficultyLevel>())
            {
                <option value="@level">@level.Label()</option>
            }
        </select>
        <div class="muted small" style="margin-top:.3rem">
            Durations ×@UserSettings.DurationMultiplier(Options.Difficulty).ToString("0.00"),
            max intensity @UserSettings.MaxIntensity(Options.Difficulty).Label().ToLower().
        </div>
    </div>

    <div class="field">
        <label>Extra focus (optional)</label>
        <div class="row wrap" style="gap:.4rem">
            @foreach (var group in Enum.GetValues<MuscleGroup>())
            {
                var selected = Options.FocusMuscleGroups.Contains(group);
                <span class="chip chip-toggle @(selected ? "selected" : "")" @onclick="() => ToggleFocus(group)">@group.Label()</span>
            }
        </div>
    </div>

    <div class="field">
        <label>Category mix</label>
        @foreach (var category in Enum.GetValues<ExerciseCategory>())
        {
            <div class="row" style="gap:.6rem;margin-bottom:.35rem">
                <span class="small" style="width:5.5rem">@category.Label()</span>
                <input class="grow" type="range" min="0" max="100" step="5" value="@Options.CategoryMix[category]"
                       @oninput="e => SetMix(category, e.Value)" />
                <span class="small muted" style="width:3.5rem;text-align:right">@Percent(category)%</span>
            </div>
        }
    </div>

    <div class="field">
        <label>Sets per work group</label>
        <select @bind="Options.Sets">
            @foreach (var option in Enum.GetValues<SetsOption>())
            {
                <option value="@option">@option.Label()</option>
            }
        </select>
        <div class="muted small" style="margin-top:.3rem">
            Work exercises are split into groups of 3-4 and each group is repeated as a circuit.
            More sets means fewer distinct exercises fit in the session. Warm-up and stretching are
            always done once.
        </div>
    </div>

    <div class="field row" style="gap:.5rem">
        <input type="checkbox" id="combos" @bind="Options.IncludeCombos" />
        <label for="combos" style="margin:0">Include combos (left/right sequences)</label>
    </div>
    <button class="btn-primary btn-block btn-lg" @onclick="RunGenerate">🎲 Generate</button>
    <p class="muted small center mt">Equipment comes from your <a href="settings">settings</a>.</p>
</div>

@if (HasDraft)
{
    <button class="btn-ghost btn-block mt" @onclick="@(() => Nav.NavigateTo("generate/preview"))">
        ‹ Back to the last generated session
    </button>
}

@code {
    private GeneratorOptions Options = new();

    private bool HasDraft => Draft.Result is not null;

    protected override async Task OnInitializedAsync()
    {
        await Settings.EnsureLoadedAsync();
        await Library.EnsureLoadedAsync();
        await Draft.EnsureLoadedAsync();
        Options = Draft.Options?.Clone() ?? new GeneratorOptions { Difficulty = Settings.Settings.Difficulty };
    }

    private void ToggleFocus(MuscleGroup group)
    {
        if (!Options.FocusMuscleGroups.Remove(group))
        {
            Options.FocusMuscleGroups.Add(group);
        }
    }

    private void SetMinutes(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var minutes))
        {
            Options.TotalMinutes = minutes;
        }
    }

    private void SetMix(ExerciseCategory category, object? value)
    {
        if (int.TryParse(value?.ToString(), out var percent))
        {
            Options.CategoryMix[category] = percent;
        }
    }

    private int Percent(ExerciseCategory category)
    {
        var total = Options.CategoryMix.Values.Sum();
        return total == 0 ? 0 : (int)Math.Round(Options.CategoryMix[category] * 100.0 / total);
    }

    private async Task RunGenerate()
    {
        var result = Generator.Generate(Options, Settings.Settings);
        await Draft.SetAsync(result, Options);
        Nav.NavigateTo("generate/preview");
    }
}

