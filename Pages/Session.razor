@page "/session"
@page "/session/{ProgramId:guid}"
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject SettingsService Settings
@inject SessionState SessionStore
@inject ProgramLibraryService ProgramLibrary
@inject HistoryService History
@inject BrowserInterop Browser

<PageTitle>Session · Chrysos</PageTitle>

@if (Program is null)
{
    <div class="empty">
        <p>No session is running.</p>
        <button class="btn-primary" @onclick="@(() => Nav.NavigateTo("generate"))">Generate a session</button>
    </div>
}
else if (Finished)
{
    <div class="card center">
        <h1>@(Aborted ? "Session ended" : "Session complete! 🎉")</h1>
        <p class="muted">@Program.Name</p>
        <div class="row wrap center mt" style="justify-content:center;gap:.4rem">
            <span class="chip ok">@EnumDisplay.Duration(ActiveSeconds) active</span>
            <span class="chip">@CompletedItems / @Program.Items.Count items</span>
        </div>
    </div>

    @if (ShowSavePrompt)
    {
        <div class="card">
            <h2>Save this program?</h2>
            <p class="muted small">That was a good one? Keep it in your program library.</p>
            <div class="field">
                <label>Program name</label>
                <input type="text" @bind="SaveName" />
            </div>
            <div class="row" style="gap:.6rem">
                <button class="btn-ghost grow" @onclick="DismissSave">Not this time</button>
                <button class="btn-primary grow" @onclick="SaveProgram">💾 Save</button>
            </div>
        </div>
    }

    <div class="row" style="gap:.6rem">
        <button class="grow" @onclick="Restart">↻ Repeat</button>
        <button class="btn-primary grow" @onclick="@(() => Nav.NavigateTo(""))">Done</button>
    </div>
}
else
{
    var step = Steps[Index];

    <div class="player @PlayerClass(step)">
        <div class="player-progress">
            @foreach (var seg in Bar)
            {
                <div class="seg @PhaseStyle.PhaseClass(seg.Phase) @PhaseStyle.GroupShade(seg.GroupIndex)" style="flex:@seg.Seconds 1 0">
                    <div style="width:@(SegmentFill(seg))%"></div>
                </div>
            }
        </div>

        <div class="row between" style="width:100%">
            <span class="step-location small">@StepLocation(step)</span>
            <span class="muted small">@EnumDisplay.Clock(TotalSeconds - ElapsedSeconds) left</span>
        </div>

        @if (step.Kind == SessionStepKind.Work)
        {
            <ExerciseMedia VideoUrl="@step.VideoUrl" Title="@step.Title" Side="step.Side" />
            <div>
                <div class="exercise-name">@step.Title</div>
                @if (step.Side != Side.None)
                {
                    <div class="side-tag">@step.Side side</div>
                }
            </div>
        }
        else
        {
            <ExerciseMedia VideoUrl="@step.NextVideoUrl" Title="@(step.NextTitle ?? step.Title)" />
            <div>
                <div class="side-tag">@step.Title · next up</div>
                <div class="exercise-name">@(step.NextTitle ?? step.Title)</div>
                @if (step.NextDurationSeconds > 0)
                {
                    <div class="muted small">@EnumDisplay.Duration(step.NextDurationSeconds)</div>
                }
            </div>
        }

        @if (step.TotalRounds > 1)
        {
            <div class="set-dots" title="@($"Set {step.Round} of {step.TotalRounds}")">
                @for (int r = 1; r <= step.TotalRounds; r++)
                {
                    <span class="dot @(r <= step.Round ? "filled" : null)"></span>
                }
            </div>
        }

        <div class="timer">@EnumDisplay.Clock(Remaining)</div>

        @if (step.Kind == SessionStepKind.Work && !string.IsNullOrWhiteSpace(step.Description))
        {
            <p class="muted small" style="margin:0">@step.Description</p>
        }
        else if (!string.IsNullOrWhiteSpace(step.NextDescription))
        {
            <p class="muted small" style="margin:0">@step.NextDescription</p>
        }

        @if (step.Kind == SessionStepKind.Work && !string.IsNullOrWhiteSpace(step.NextTitle))
        {
            <p class="muted small" style="margin:0">
                Next: @step.NextTitle
                @if (step.NextDurationSeconds > 0)
                {
                    <text> · @EnumDisplay.Duration(step.NextDurationSeconds)</text>
                }
            </p>
        }

        <div class="player-controls">
            <button @onclick="Previous" disabled="@(Index == 0)">⏮</button>
            <button class="btn-primary" @onclick="TogglePause">@(Paused ? "▶ Resume" : "⏸ Pause")</button>
            <button @onclick="Next">⏭</button>
        </div>
        <button class="btn-danger btn-block" @onclick="() => ShowQuit = true">End session</button>
    </div>

    <ConfirmDialog Visible="ShowQuit"
                   Title="End the session?"
                   Message="Your progress so far will be saved to history."
                   ConfirmText="End session"
                   Confirmed="QuitAsync"
                   Cancelled="() => ShowQuit = false" />

    <div class="progress-handle @PlayerClass(step)"
         @onclick="OpenSheet"
         @ontouchstart="TouchStart"
         @ontouchend="HandleTouchEnd">
        <span class="handle-grip"></span>
        <span>@(step.ItemIndex + 1) of @Program.Items.Count · <span class="handle-phase">@step.Phase.Label()</span></span>
        <span>▲</span>
    </div>

    @if (SheetOpen)
    {
        <div class="progress-backdrop" @onclick="CloseSheet"></div>
        <div class="progress-sheet @PlayerClass(step)">
            <div class="sheet-head" @onclick="CloseSheet" @ontouchstart="TouchStart" @ontouchend="SheetTouchEnd">
                <span class="handle-grip"></span>
                <strong>@Program.Name</strong>
                <span class="muted small">▼</span>
            </div>
            <div class="sheet-body">
                <ProgramOutline Program="Program" CurrentItemIndex="step.ItemIndex" CurrentRowId="@CurrentRowId" />
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid? ProgramId { get; set; }

    private WorkoutProgram? Program;
    private List<SessionStep> Steps = new();
    private int Index;
    private int Remaining;
    private int ActiveSeconds;
    private bool Paused;
    private bool Finished;
    private bool Aborted;
    private bool ShowQuit;
    private bool ShowSavePrompt;
    private bool IsUnsaved;
    private string SaveName = string.Empty;
    private HistoryEntry? HistoryRecord;
    private CancellationTokenSource? _cts;

    private const string CurrentRowId = "session-current-row";
    private bool SheetOpen;
    private bool _scrollPending;
    private double _touchStartY;

    private readonly List<ProgressSegment> Bar = new();
    private int[] _stepStart = Array.Empty<int>();
    private int _totalSeconds;

    private int TotalSeconds => _totalSeconds;
    private int ElapsedSeconds => Steps.Count > Index
        ? _stepStart[Index] + (Steps[Index].DurationSeconds - Remaining)
        : _totalSeconds;
    private int CompletedItems => Finished && !Aborted
        ? (Program?.Items.Count ?? 0)
        : (Steps.Count > Index ? Steps[Index].ItemIndex : (Program?.Items.Count ?? 0));

    /// <summary>A run of consecutive steps sharing a phase and work group, drawn as one bar section.</summary>
    private class ProgressSegment
    {
        public ProgramPhase Phase { get; set; }
        public int GroupIndex { get; set; }
        public int StartSeconds { get; set; }
        public int Seconds { get; set; }
    }

    private void BuildProgressBar()
    {
        Bar.Clear();
        _stepStart = new int[Steps.Count];
        var elapsed = 0;

        for (int i = 0; i < Steps.Count; i++)
        {
            var step = Steps[i];
            _stepStart[i] = elapsed;

            var last = Bar.Count > 0 ? Bar[^1] : null;
            if (last is not null && last.Phase == step.Phase && last.GroupIndex == step.GroupIndex)
            {
                last.Seconds += step.DurationSeconds;
            }
            else
            {
                Bar.Add(new ProgressSegment
                {
                    Phase = step.Phase,
                    GroupIndex = step.GroupIndex,
                    StartSeconds = elapsed,
                    Seconds = step.DurationSeconds
                });
            }

            elapsed += step.DurationSeconds;
        }

        _totalSeconds = elapsed;
    }

    private int SegmentFill(ProgressSegment segment)
    {
        if (segment.Seconds <= 0)
        {
            return 0;
        }

        var into = Math.Clamp(ElapsedSeconds - segment.StartSeconds, 0, segment.Seconds);
        return (int)Math.Round(into * 100.0 / segment.Seconds);
    }

    protected override async Task OnInitializedAsync()
    {
        await Settings.EnsureLoadedAsync();
        await ProgramLibrary.EnsureLoadedAsync();
        await History.EnsureLoadedAsync();

        if (ProgramId is not null)
        {
            Program = ProgramLibrary.Get(ProgramId.Value)?.Clone();
            IsUnsaved = false;
        }
        else
        {
            Program = await SessionStore.RestoreAsync();
            IsUnsaved = SessionStore.IsUnsaved;
        }

        if (Program is null)
        {
            return;
        }

        SaveName = Program.Name;
        Steps = SessionBuilder.Build(Program, Settings.Settings);
        BuildProgressBar();

        if (Steps.Count == 0)
        {
            Finished = true;
            return;
        }

        Remaining = Steps[0].DurationSeconds;
        await AnnounceAsync(Steps[0]);

        if (Settings.Settings.KeepScreenAwake)
        {
            await Browser.RequestWakeLockAsync();
        }

        _ = RunAsync();
    }

    private async Task RunAsync()
    {
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (Paused || Finished)
                {
                    continue;
                }

                Remaining--;

                if (Steps[Index].Kind == SessionStepKind.Work)
                {
                    ActiveSeconds++;
                }

                if (Remaining is > 0 and <= 3)
                {
                    await BeepAsync(880, 80);
                }
                else if (Remaining <= 0)
                {
                    await BeepAsync(1320, 220);
                    await AdvanceAsync();
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // session stopped
        }
    }

    private async Task BeepAsync(int frequency, int ms)
    {
        if (!Settings.Settings.SoundEnabled)
        {
            return;
        }

        try
        {
            await Browser.BeepAsync(frequency, ms);
        }
        catch
        {
            // audio is best effort
        }
    }

    private async Task AdvanceAsync()
    {
        if (Index + 1 >= Steps.Count)
        {
            await FinishAsync(aborted: false);
            return;
        }

        await EnterStepAsync(Index + 1);
    }

    private async Task EnterStepAsync(int index)
    {
        Index = index;
        Remaining = Steps[Index].DurationSeconds;
        await AnnounceAsync(Steps[Index]);

        if (SheetOpen)
        {
            _scrollPending = true;
        }
    }

    /// <summary>Speaks the upcoming exercise during a rest or lead-in step.</summary>
    private async Task AnnounceAsync(SessionStep step)
    {
        if (!Settings.Settings.SpeakExerciseNames)
        {
            return;
        }

        var text = Announcement(step);
        if (text is null)
        {
            return;
        }

        try
        {
            await Browser.SpeakAsync(text);
        }
        catch
        {
            // speech is best effort
        }
    }

    private static string? Announcement(SessionStep step)
    {
        if (step.Kind == SessionStepKind.Work || string.IsNullOrWhiteSpace(step.NextTitle))
        {
            return null;
        }

        var title = step.NextTitle;

        if (step.Side == Side.None)
        {
            return title;
        }

        var suffix = $" ({step.Side})";
        if (title.EndsWith(suffix, StringComparison.Ordinal))
        {
            title = title[..^suffix.Length];
        }

        return $"{title}, {step.Side} side";
    }

    private async Task StopSpeakingAsync()
    {
        try
        {
            await Browser.CancelSpeechAsync();
        }
        catch
        {
            // speech is best effort
        }
    }

    private async Task TogglePause()
    {
        Paused = !Paused;

        if (Paused)
        {
            await StopSpeakingAsync();
        }
    }

    private async Task Next()
    {
        await StopSpeakingAsync();

        if (Index + 1 >= Steps.Count)
        {
            await FinishAsync(aborted: false);
            return;
        }

        await EnterStepAsync(Index + 1);
    }

    private async Task Previous()
    {
        await StopSpeakingAsync();
        await EnterStepAsync(Index == 0 ? 0 : Index - 1);
    }

    private void OpenSheet()
    {
        SheetOpen = true;
        _scrollPending = true;
    }

    private void CloseSheet() => SheetOpen = false;

    private void TouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _touchStartY = e.Touches[0].ClientY;
        }
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        if (SwipeDistance(e) < -30)
        {
            OpenSheet();
        }
    }

    private void SheetTouchEnd(TouchEventArgs e)
    {
        if (SwipeDistance(e) > 30)
        {
            CloseSheet();
        }
    }

    private double SwipeDistance(TouchEventArgs e)
        => e.ChangedTouches.Length > 0 ? e.ChangedTouches[0].ClientY - _touchStartY : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollPending || !SheetOpen)
        {
            return;
        }

        _scrollPending = false;

        try
        {
            await Browser.ScrollIntoViewAsync(CurrentRowId);
        }
        catch
        {
            // scrolling is best effort
        }
    }

    private async Task QuitAsync()
    {
        ShowQuit = false;
        await FinishAsync(aborted: true);
    }

    private async Task FinishAsync(bool aborted)
    {
        Finished = true;
        Aborted = aborted;
        SheetOpen = false;
        _cts?.Cancel();
        await StopSpeakingAsync();
        await Browser.ReleaseWakeLockAsync();

        if (Program is not null)
        {
            HistoryRecord = await History.AddAsync(Program, !aborted, ActiveSeconds);
            ShowSavePrompt = IsUnsaved && !ProgramLibrary.Contains(Program.Id);
        }

        await SessionStore.ClearAsync();
        StateHasChanged();
    }

    private async Task SaveProgram()
    {
        if (Program is null)
        {
            return;
        }

        var copy = Program.Clone();
        copy.Name = string.IsNullOrWhiteSpace(SaveName) ? Program.Name : SaveName.Trim();
        await ProgramLibrary.SaveAsync(copy);

        if (HistoryRecord is not null)
        {
            await History.MarkSavedAsync(HistoryRecord.Id);
        }

        ShowSavePrompt = false;
    }

    private void DismissSave() => ShowSavePrompt = false;

    private async Task Restart()
    {
        if (Program is null)
        {
            return;
        }

        Index = 0;
        ActiveSeconds = 0;
        Remaining = Steps.Count > 0 ? Steps[0].DurationSeconds : 0;
        Finished = false;
        Aborted = false;
        Paused = false;
        ShowSavePrompt = false;
        await SessionStore.StartAsync(Program, IsUnsaved);

        if (Steps.Count > 0)
        {
            await AnnounceAsync(Steps[0]);
        }

        _ = RunAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        try
        {
            await Browser.CancelSpeechAsync();
            await Browser.ReleaseWakeLockAsync();
        }
        catch
        {
            // ignored
        }
    }

    private static string PlayerClass(SessionStep step)
    {
        var classes = PhaseStyle.PhaseClass(step.Phase);

        if (PhaseStyle.GroupShade(step.GroupIndex) is { } shade)
        {
            classes += $" {shade}";
        }

        return step.Kind == SessionStepKind.Work ? classes : $"{classes} resting";
    }

    private static string PhaseIcon(ProgramPhase phase) => PhaseStyle.PhaseIcon(phase);

    private static string StepLocation(SessionStep step)
    {
        var text = $"{PhaseIcon(step.Phase)} {step.Phase.Label()}";

        if (step.Phase == ProgramPhase.Main && step.GroupCount > 1)
        {
            text += $" · group {step.GroupIndex}/{step.GroupCount}";
        }

        return text;
    }
}
